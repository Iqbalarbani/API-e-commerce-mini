# Application
APP_NAME="Mini Shop API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (PostgreSQL 16)
POSTGRES_USER=minishop
POSTGRES_PASSWORD=minishop_secret
POSTGRES_DB=minishop_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://minishop:minishop_secret@db:5432/minishop_db

# Test Database
TEST_DATABASE_URL=postgresql+psycopg://minishop:minishop_secret@db:5432/minishop_test_db

# Security & JWT (used in Auth stage)
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
LOGIN_RATE_LIMIT=5/minute
